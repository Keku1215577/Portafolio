{
  "name": "Olist Analytics - Executive",
  "dataColors": [
    "#164E63",
    "#0F766E",
    "#0891B2",
    "#2563EB",
    "#64748B",
    "#D97706",
    "#B91C1C",
    "#7C3AED",
    "#4D7C0F",
    "#DB2777"
  ],
  "background": "#F5F7FA",
  "foreground": "#172B4D",
  "tableAccent": "#0F766E",
  "good": "#0F766E",
  "neutral": "#64748B",
  "bad": "#B91C1C",
  "maximum": "#164E63",
  "center": "#E2E8F0",
  "minimum": "#D97706",
  "null": "#CBD5E1",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#172B4D"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#334155"
    },
    "callout": {
      "fontFace": "Segoe UI",
      "fontSize": 28,
      "color": "#164E63"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#64748B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontFace": "Segoe UI Semibold",
            "fontSize": 12,
            "color": {
              "solid": {
                "color": "#172B4D"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "radius": 8
          }
        ]
      }
    }
  }
}